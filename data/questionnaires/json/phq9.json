  "metadata": {
    "description": "Nine-item self-report measure of depressive symptom frequency and severity during the preceding two weeks.",
    "intended_use": "Screening and monitoring depressive symptoms in primary care and research; the score is not a diagnosis by itself.",
    "name_origin": "Patient Health Questionnaire, nine-item depression module; commonly shortened to PHQ-9.",
    "development_history": "Published and validated as the nine-item depression module of the PHQ in 2001; language versions must be interpreted with their own evidence.",
    "measurement_rationale": "The items represent core depressive symptom domains and use a common two-week frequency frame to support a severity summary.",
    "interpretation_notes": "Cutoffs, diagnostic accuracy, and response to change depend on the setting, population, language version, and clinical assessment.",
    "keywords": [
      "depression",
      "mental health",
      "primary care"
    ],
